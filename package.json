
{
  "name": "texfriend-forever",
  "version": "1.0.0",
  "description": "TEXFRIEND FOREVER - Web Application",
  "private": true,
  "homepage": "./",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build-windows": "electron-builder --win --publish never",
    "build-windows-installer": "electron-builder --win nsis --publish never",
    "build-android": "cordova build android",
    "build-android-release": "cordova build android --release",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.texfriend.forever",
    "productName": "TEXFRIEND FOREVER",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TEXFRIEND FOREVER",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
