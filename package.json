{
  "name": "texfriend-forever-app",
  "version": "1.0.0",
  "description": "TexFriend Forever App",
  "author": "kumar1972",
  "main": "main.js",
  },
  {
  "scripts": {
    "start": "electron .",
    "build-windows": "electron-builder --win",
    "build-windows-installer": "electron-builder --win nsis",
    "build-android": "cordova build android",
    "build-android-release": "cordova build android --release"
  }
}
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.texfriend.forever",
    "productName": "TexFriend Forever",
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "icon-512.ico"
    },
    "files": [
      "**/*"
    ]
  }
}
